{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). It lives
 ;; in the kotoba-lang org of this workspace (transferred + renamed from
 ;; com-junkawasaki/langgraph-clj / com-junkawasaki/langchain-clj). This
 ;; repo is standalone (forkable outside the workspace); the :local/root
 ;; paths only resolve inside the monorepo checkout — a standalone fork
 ;; should override them with git coordinates.
 :deps {io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}
        io.github.kotoba-lang/robotics
        {:local/root "../../kotoba-lang/robotics"}
        ;; REAL engineering-simulation dependency (ADR-2607152000, extending
        ;; ADR-2607151600's automotive pilot and ADR-2607152000's autoparts/
        ;; cementmill fleet extension to THIS vertical): commsdevice.robotics
        ;; actually calls physics-2d/world-step -- a real, tested time-stepped
        ;; rigid-body impulse solver -- to run a real display-module optical-
        ;; bonding (OCA lamination) press simulation, instead of comparing
        ;; static self-reported fields. This vertical has no design-library
        ;; sibling repo, so the physics module is built directly in
        ;; commsdevice.robotics and the ONLY new dependency is physics-2d
        ;; itself, taken as a real pinned git-coordinate dep (not :local/root)
        ;; so this repo stays forkable standalone outside the monorepo.
        io.github.kotoba-lang/physics-2d
        {:git/url "https://github.com/kotoba-lang/physics-2d.git"
         :sha "03b6c23c8d9aa36b92a8130fd3e37fc2548b4d26"}
        ;; Cross-actor supply-chain-linkage contract (ADR-2607999950,
        ;; extended by ADR-2607999960/ADR-2607999970, direct-ported to
        ;; the smartphone chain by ADR-2607999980): `commsdevice.
        ;; governor` independently re-verifies each OPTIONAL entry of
        ;; `:upstream-component-pedigrees` (a `kotoba.pedigree` record
        ;; an upstream isic-2610 fab lot issued via `fab.export/
        ;; pedigree-for-lot`) before accepting it as evidence a
        ;; device-unit's incoming component clears this actor's own
        ;; acceptance floor. A real pinned git-coordinate dep (not
        ;; :local/root), same reasoning physics-2d above already
        ;; establishes -- SAME SHA every other cloud-itonami-isic-*
        ;; actor in this fleet already pins (the SHA that added
        ;; `:pedigree/upstream` chaining support).
        io.github.kotoba-lang/pedigree
        {:git/url "https://github.com/kotoba-lang/pedigree.git"
         :sha "f85784211422a651fea26f448f601abfba2e7d61"}}
 :aliases
 {;; offline workspace dev -- pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; clojure -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "commsdevice.sim"]}
  :export {:main-opts ["-m" "commsdevice.export-run"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; ADR-2607999980's headline end-to-end proof: the GENUINE full
  ;; 2-hop, 3-actor smartphone supply-chain-pedigree chain (isic-0729
  ;; non-ferrous-ore mining -> isic-2610 semiconductor fab -> isic-2630
  ;; THIS actor). ALSO a real cross-repo call two hops further back
  ;; into cloud-itonami-isic-0729's own `nonferrousops.export`/
  ;; `nonferrousops.store` (a real production record, written and read
  ;; back through that repo's OWN store -> a real kotoba.pedigree
  ;; record), attached to the fab lot as its own `:upstream-ore-
  ;; pedigree` BEFORE calling isic-2610's `pedigree-for-lot`, so the
  ;; component pedigree this actor receives carries a genuinely
  ;; 2-level-deep `:pedigree/upstream` chain (fab lot embeds ore)
  ;; beneath ITS OWN top level. isic-0729 is needed directly here too,
  ;; same reasoning as isic-2610 below -- tools.deps does NOT compose
  ;; another :local/root dependency's own ALIAS-scoped deps (isic-2610's
  ;; OWN `:cross-repo-test` alias dependency on isic-0729 is invisible
  ;; from here), so this alias declares BOTH siblings itself directly --
  ;; the automotive chain's own `cloud-itonami-isic-2910` established
  ;; this exact multi-sibling technique one link earlier (ADR-2607999970).
  ;; Kept out of the default :test alias (and its own test-cross-repo/
  ;; source root) so plain `clojure -M:dev:test` never REQUIRES same-org
  ;; sibling checkouts a casual fork of just this repo would not have.
  ;; Still no live network call at runtime: this is a build-time
  ;; classpath dependency exercised by tests, the same category as
  ;; every other :local/root dep in this fleet.
  :cross-repo-test
  {:extra-paths ["test-cross-repo"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                io.github.cloud-itonami/cloud-itonami-isic-2610
                {:local/root "../cloud-itonami-isic-2610"}
                io.github.cloud-itonami/cloud-itonami-isic-0729
                {:local/root "../cloud-itonami-isic-0729"}}
   :main-opts ["-m" "cognitect.test-runner" "-d" "test-cross-repo"]
   :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test" "test-cross-repo"
                        "--fail-level" "error"]}}}
