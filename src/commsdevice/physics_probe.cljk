(ns commsdevice.physics-probe
  "The physical-AI bot's measurement: run this actor's REAL `physics-2d`
  display-module optical-bonding (OCA lamination) press simulation
  (`commsdevice.robotics/simulate-bonding-press`) over a fixed sweep and
  print ONE EDN map of the physical quantities it computed.

    kbb -M:dev:physics

  This is what the resident bot (hermes/profiles/physai-isic-2630/SOUL.md)
  reads every tick. Every number below is derived from a time-stepped
  trajectory by `commsdevice.robotics/bonding-telemetry-for`, never typed
  in. Output schema `itonami.physical-ai.probe.v1`:

    {:physics-probe/schema \"itonami.physical-ai.probe.v1\"
     :repo :procedure :solver
     :runs     [{:input {...} :quantities {...} :out-of-tolerance? bool} ...]
     :derived  {...}   ; quantities computed ACROSS runs
     :count n :expected n}

  `:count` is an evidence floor: 0 means \"could not measure\", never
  \"nothing out of tolerance\". Exit 0 when every run produced numbers,
  2 when any run did not."
  (:require [commsdevice.robotics :as robotics]))

(def schema "itonami.physical-ai.probe.v1")

(def band
  "The [min max] MPa acceptance band every `commsdevice.store` seed
  device-unit carries (= `robotics/min-bonding-pressure-mpa` /
  `robotics/max-bonding-pressure-mpa`)."
  {:bonding-pressure-min-mpa robotics/min-bonding-pressure-mpa
   :bonding-pressure-max-mpa robotics/max-bonding-pressure-mpa})

(def sweep-platen-masses-kg
  "18 / 20 / 45 kg are the platen masses the `commsdevice.store` seed
  device-units carry (45 kg is the seeded over-pressure unit); 8 and 30 kg
  bracket them so both edges of the band are crossed inside the sweep."
  [8.0 18.0 20.0 30.0 45.0])

(def ^:private telemetry-keys
  [:sim-peak-bonding-force-n :sim-peak-bonding-pressure-mpa :sim-peak-bond-travel-m
   :ticks :dt :closing-velocity-mps])

(defn- run-one [mass-kg]
  (let [unit (assoc band :bonding-press-platen-mass-kg mass-kg)
        t (select-keys (robotics/bonding-telemetry-for unit) telemetry-keys)]
    {:input unit
     :quantities t
     :out-of-tolerance? (boolean (robotics/bonding-pressure-out-of-range? (merge unit t)))}))

(defn- pressure-at [mass-kg]
  (:sim-peak-bonding-pressure-mpa (robotics/bonding-telemetry-for {:bonding-press-platen-mass-kg mass-kg})))

(defn mass-at-pressure-kg
  "Platen mass (kg) at which the simulated peak bonding pressure reaches
  `target-mpa`, by bisection over the REAL simulation (pressure rises with
  mass at fixed closing velocity). nil when the bracket does not straddle
  the target."
  ([target-mpa] (mass-at-pressure-kg target-mpa 0.1 200.0 40))
  ([target-mpa lo hi iters]
   (when (and (< (pressure-at lo) target-mpa) (>= (pressure-at hi) target-mpa))
     (loop [lo lo hi hi i 0]
       (if (>= i iters)
         hi
         (let [mid (/ (+ lo hi) 2.0)]
           (if (>= (pressure-at mid) target-mpa)
             (recur lo mid (inc i))
             (recur mid hi (inc i)))))))))

(defn probe []
  (let [runs (mapv run-one sweep-platen-masses-kg)
        numeric? (fn [r] (number? (get-in r [:quantities :sim-peak-bonding-pressure-mpa])))
        travels (map #(get-in % [:quantities :sim-peak-bond-travel-m]) runs)]
    {:physics-probe/schema schema
     :repo "cloud-itonami/cloud-itonami-isic-2630"
     :procedure "display-module optical bonding (OCA lamination) press cycle, robot display-bonding cell"
     :solver "physics-2d/world-step"
     :runs runs
     :derived {:band-mpa [robotics/min-bonding-pressure-mpa robotics/max-bonding-pressure-mpa]
               ;; the platen-mass window whose simulated pressure lands in the band
               :min-passing-platen-mass-kg (mass-at-pressure-kg robotics/min-bonding-pressure-mpa)
               :max-passing-platen-mass-kg (mass-at-pressure-kg robotics/max-bonding-pressure-mpa)
               ;; pressure per kg of platen at the fixed closing velocity
               :pressure-per-kg-mpa (let [r (first runs)]
                                      (/ (get-in r [:quantities :sim-peak-bonding-pressure-mpa])
                                         (get-in r [:input :bonding-press-platen-mass-kg])))
               ;; bond travel vs the OCA layer it stands for
               :oca-layer-thickness-m robotics/crush-travel-m
               :max-bond-travel-m (when (every? number? travels) (reduce max travels))}
     :count (count (filter numeric? runs))
     :expected (count sweep-platen-masses-kg)}))

(defn -main [& _]
  (let [p (probe)]
    (prn p)
    (when-not (= (:count p) (:expected p))
      #?(:cljs (set! (.-exitCode js/process) 2)
         :default (System/exit 2)))))
